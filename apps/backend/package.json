{
  "name": "@terrarium/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TERRARIUM_DEV=1 TERRARIUM_PORT=${TERRARIUM_PORT:-8787} node --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/store/migrations && cp src/store/migrations/*.sql dist/store/migrations/",
    "test": "node --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:e2e": "TERRARIUM_E2E=1 node --test --test-concurrency=1 src/e2e.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.14.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@terrarium/shared": "workspace:*",
    "diff": "9.0.0",
    "just-bash": "3.6.0",
    "undici": "6.29.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "7.0.2"
  }
}
