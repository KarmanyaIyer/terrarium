{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Terrarium",
  "version": "0.1.0",
  "identifier": "dev.karvi.terrarium",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../apps/ui/dist",
    "beforeDevCommand": "pnpm --filter @terrarium/ui dev",
    "beforeBuildCommand": "pnpm --filter @terrarium/ui build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:5173 ws://localhost:5173",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "copyright": "Karmanya Iyer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "15.0"
    }
  }
}
